# ─── AI Laptop Voice Handler ─── Environment Variables ───
# Copy this file to .env and fill in values as needed.

# Gemini API key (optional — only needed if using Gemini as LLM provider)
GEMINI_API_KEY=

# LLM provider: rule_based | ollama | gemini
LLM_PROVIDER=rule_based

# Ollama settings (optional — only needed if using Ollama)
OLLAMA_MODEL=phi3:mini
OLLAMA_URL=http://localhost:11434
